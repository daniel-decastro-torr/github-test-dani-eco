    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtenemos el texto que viene de OpenAI\nconst rawText = $json['0'].content[0].text;\n\n// Limpiamos el texto eliminando los bloques de código Markdown si existen\nconst cleanJson = rawText.replace(/```json|```/g, \"\").trim();\n\ntry {\n  // Convertimos el texto a un objeto JSON real\n  const data = JSON.parse(cleanJson);\n\n  // Retornamos los campos específicos\n  return {\n    empresa: data.empresa,\n    fecha: data.fecha,\n    cantidad: data.cantidad\n  };\n} catch (error) {\n  // En caso de que OpenAI no devuelva un JSON válido\n  return {\n    error: \"No se pudo parsear el JSON\",\n    raw: rawText\n  };\n}"
      },
